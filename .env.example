# --- Azure AI Foundry (powers the harness agent) ---
# Project endpoint from the Foundry portal, and a chat model deployment name.
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL_DEPLOYMENT=gpt-5.4-mini
# Set when the Foundry project lives in a different Entra tenant than your default az context.
FOUNDRY_TENANT_ID=
# Set to pin the az subscription (and thus the cached identity) used for Foundry auth.
FOUNDRY_SUBSCRIPTION_ID=

# --- Databricks Agent Bricks "Care Copilot" (the tool) ---
DATABRICKS_HOST=https://adb-7405606288996838.18.azuredatabricks.net
DATABRICKS_SERVING_ENDPOINT=mas-cebe7f3f-endpoint
DATABRICKS_CLIENT_ID=c05dfeba-2e3c-40d4-a1ab-65ea1faa2e4a
# Sent separately by the Databricks team — never commit the real value.
DATABRICKS_CLIENT_SECRET=

# --- Harness tuning (optional) ---
# Set to 1 to enable the harness's built-in hosted web search tool — requires a
# Foundry project with Bing grounding; otherwise runs 404. The Databricks
# supervisor has its own web tool either way, so the default is off.
HARNESS_ENABLE_WEB_SEARCH=
HARNESS_MAX_CONTEXT_TOKENS=272000
HARNESS_MAX_OUTPUT_TOKENS=16384
